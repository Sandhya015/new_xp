# Copy to .env and fill in. Never commit .env to git.

# --- Local dev (Flask + Vite) ---
# 1) Backend: from backend/ run  python run.py  → API at http://127.0.0.1:5000
# 2) Frontend: from frontend/ run  npm run dev  → open http://localhost:5173
#    getApiBase() uses http://localhost:5000 automatically on localhost (no VITE_API_URL needed).
# 3) If you open the UI by LAN IP (e.g. http://192.168.1.5:5173), set in frontend/.env:
#    VITE_API_URL=http://192.168.1.5:5000
# 4) Zoho: set SMTP_* below and keep EMAIL_TRANSPORT=smtp (or omit — smtp is the default).
#    Do not set EMAIL_TRANSPORT=ses unless you configure SES.

# MongoDB Atlas (replace <db_password> with your Atlas DB user password)
# Cluster: cluster0.yhkeqow.mongodb.net — user: xpertintern_app
MONGODB_URI=mongodb+srv://xpertintern_app:<db_password>@cluster0.yhkeqow.mongodb.net/xpertintern?retryWrites=true&w=majority&appName=Cluster0

# Or use MONGO_URI (same value)
# MONGO_URI=mongodb+srv://...

# Secret for session/JWT (generate a random string for production)
SECRET_KEY=your-secret-key-change-in-production
# JWT_SECRET_KEY=optional-override-for-jwt

# CORS: comma-separated origins that can call the API (frontend URL).
# Any https://*.vercel.app and https://*.amplifyapp.com origin is also accepted at runtime (no need to list every preview URL).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email allowed to sign in via POST /api/auth/admin/login (must exist in Mongo with role admin)
# ADMIN_PANEL_ALLOWED_EMAIL=admin@xpertintern.com

# Razorpay — Dashboard → Settings → API Keys (Test mode for local dev)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Optional: extra API Gateway CORS origin at deploy (e.g. primary Amplify URL or custom domain).
# Add each non-wildcard preview host here if OPTIONS preflight must succeed from that exact origin.
# FRONTEND_ORIGIN=https://main.d1234abcd.amplifyapp.com

# Deploy loads this file (useDotenv in serverless.yml). Run deploy from backend/ so
# RAZORPAY_* and secrets are injected — otherwise Lambda env can end up empty after deploy.

# Zoho SMTP (welcome / enrollment / certificate / registration OTP). Omit to skip sending mail locally.
# Use smtp explicitly so SES is never picked up by mistake.
EMAIL_TRANSPORT=smtp
# India-hosted org mailboxes often need SMTP_HOST=smtp.zoho.in (smtp.zoho.com may return 535).
SMTP_HOST=smtp.zoho.in
SMTP_PORT=587
SMTP_USER=admin@xpertintern.com
# Double quotes required if password contains # (otherwise .env treats # as comment)
SMTP_PASSWORD="your-zoho-app-password"
# Send as admin@ (Zoho mailbox used for SMTP_USER); replies go to contact@
MAIL_FROM=admin@xpertintern.com
MAIL_FROM_NAME=XpertIntern
MAIL_REPLY_TO=contact@xpertintern.com

# If 587 fails, try Zoho SSL: SMTP_PORT=465 and SMTP_USE_SSL=1
# India-hosted mailboxes sometimes use SMTP_HOST=smtp.zoho.in
# Lambda: default SMTP_TIMEOUT is 10s so API Gateway (29s max) does not return 504 while SMTP hangs.
# SMTP_TIMEOUT=10

# Optional: do not send welcome email on student register.
# REGISTER_SKIP_WELCOME_EMAIL=1

# One-off: allow scripts/send_sample_transactional_emails.py when FLASK_ENV is not development (avoid in production).
# ALLOW_EMAIL_TEST_SCRIPT=1

# Most transactional mail (enrollment, payment, certificate) defaults to BACKGROUND so APIs stay fast.
# Student welcome on AWS Lambda always runs in the request thread (Lambda freezes daemon threads after response).
# Optional: force ALL mail synchronous (debug / non-Lambda hosts with similar thread issues):
# EMAIL_SEND_SYNC=1

# --- Amazon SES (recommended on Lambda; same region as API, e.g. ap-south-1) ---
# 1) AWS Console → SES → Verified identities: verify your domain OR single email.
# 2) SES → Account dashboard: request production access (sandbox only allows verified recipients).
# 3) Deploy: EMAIL_TRANSPORT=ses SES_FROM_EMAIL=verified@yourdomain.com (and MAIL_FROM_NAME).
#    Lambda role gets ses:SendEmail / ses:SendRawEmail via serverless.yml (redeploy after pull).
# SES_REGION=ap-south-1
# EMAIL_TRANSPORT=ses
# SES_FROM_EMAIL=noreply@xpertintern.com

# Optional: links in transactional emails (welcome, OTP, forgot-password) — default https://www.xpertintern.com
# For local reset links use your Vite origin, e.g. PUBLIC_FRONTEND_URL=http://localhost:5173
# PUBLIC_FRONTEND_URL=https://www.xpertintern.com

# Admin course uploads via POST /api/admin/uploads/course-media:
#   kind=featured | intro | lesson (video MP4/MOV/AVI) | material (PDF/PPT/DOC/XLS/ZIP/TXT/CSV).
# MAX_COURSE_INTRO_UPLOAD_MB=80
# MAX_COURSE_LESSON_UPLOAD_MB=80
# MAX_COURSE_STUDY_MATERIAL_UPLOAD_MB=50

# Course media (featured image, intro/lesson video, study materials):
# On AWS Lambda, serverless.yml provisions a private S3 bucket and sets COURSE_MEDIA_S3_BUCKET.
#
# If you omit the bucket locally, uploads go to instance/course_uploads/ on disk only.
# GET /api/courses/media/... then works at http://localhost:5000 but the same path on the
# deployed API reads S3 — so covers uploaded locally will look broken on the live site.
# Fix: either (1) set the lines below to the SAME dev bucket name as your deployed stack
# (AWS Console → S3, or CloudFormation output CourseMediaBucket) and use AWS credentials
# with s3:GetObject/PutObject/HeadObject for that bucket, or (2) upload covers only from
# the admin UI when it points at the deployed API (VITE_API_URL=... in frontend/.env).
# COURSE_MEDIA_S3_BUCKET=xpertintern-api-dev-coursemediabucket-xxxxxxxx
# COURSE_MEDIA_S3_PREFIX=course-media

# Local Flask (optional; default 5000)
# PORT=5000

# Use development locally so DEBUG and dev CORS defaults apply
FLASK_ENV=development

# --- Deploy (Lambda): set the same keys in CI or `serverless deploy` environment;
# never commit real values. See backend/serverless.yml provider.environment.
